vm-intranet-rrhh = 10.10.0.101 (IP publica: None)
==> Esperando a que Nginx quede activo en la intranet

##### PRUEBA INTRANET 1: vm-intranet-rrhh: Nginx activo, configuracion valida y virtual host
ip-10-10-0-101.ec2.internal
10.10.0.101 
nginx: active
LISTEN 0      511          0.0.0.0:80        0.0.0.0:*    users:(("nginx",pid=4301,fd=9),("nginx",pid=4300,fd=9),("nginx",pid=4299,fd=9))
--- /etc/nginx/conf.d/rrhh.conf
# Cualquier nombre distinto al de la intranet: se cierra la conexion sin responder
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# Virtual host de la intranet de Recursos Humanos
server {
    listen 80;
    server_name rrhh.mansiondeldisfraz.local;

    root /usr/share/nginx/rrhh;
    index index.html;
    charset utf-8;

    access_log /var/log/nginx/rrhh.access.log main;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        try_files $uri $uri/ =404;
    }
}

